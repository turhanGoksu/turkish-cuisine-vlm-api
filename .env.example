# Copy this file to .env and choose your own password.
# The real .env is git-ignored and must never be committed.

POSTGRES_USER=turkish_cuisine
POSTGRES_PASSWORD=choose_a_password
POSTGRES_DB=turkish_cuisine

# Upper bound on generated tokens. Each token costs roughly a second of CPU time,
# so this is the main knob on worst-case request latency.
MAX_NEW_TOKENS=150

# Ceiling on image resolution fed to the model, in pixels. 401408 is about
# 634x634; lowering it shortens the prompt and speeds up inference.
MAX_PIXELS=401408
